# Autodesk Platform Services application credentials
# Create at https://aps.autodesk.com/myapps (Traditional Web App)
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# After running: uv run python scripts/oauth_login.py
# Paste the refresh token here for headless/cloud use (no browser callback needed in agent VM)
APS_REFRESH_TOKEN=

# OAuth callback used only by scripts/oauth_login.py on your local machine
APS_REDIRECT_URI=http://localhost:8080/callback

# Optional: narrow search to a known project name (e.g. growbox, fission, canna)
FUSION_PROJECT_HINT=growbox
